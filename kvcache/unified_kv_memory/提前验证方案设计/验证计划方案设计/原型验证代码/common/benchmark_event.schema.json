{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "benchmark_event.schema.json",
  "title": "Unified KV Benchmark Event",
  "type": "object",
  "required": [
    "run_id",
    "trace_id",
    "request_id",
    "event_name",
    "monotonic_timestamp_ns",
    "status",
    "evidence_level",
    "package_id",
    "config_hash",
    "hardware_profile"
  ],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "trace_id": {"type": "string", "minLength": 1},
    "request_id": {"type": "string", "minLength": 1},
    "event_name": {"type": "string", "minLength": 1},
    "monotonic_timestamp_ns": {"type": "integer", "minimum": 0},
    "duration_ns": {"type": ["integer", "null"], "minimum": 0},
    "planned_path": {"type": ["string", "null"]},
    "actual_path": {"type": ["string", "null"]},
    "payload_bytes": {"type": ["integer", "null"], "minimum": 0},
    "status": {"enum": ["OK", "ERROR", "FALLBACK", "INVALID_EVIDENCE", "NOT_SUPPORTED"]},
    "error_code": {"type": ["string", "null"]},
    "invalid_reason": {"type": ["string", "null"]},
    "evidence_level": {"enum": ["DEMO", "LAB", "MEASURED"]},
    "package_id": {"type": "string", "minLength": 1},
    "config_hash": {"type": "string", "minLength": 1},
    "hardware_profile": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}
