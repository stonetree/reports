# ==============================================================================
# 控制面压测环境环境变量模板 (.env.example)
# 使用方法：复制本文件为 .env，并修改内部真实的 IP 与端口
# cp .env.example .env
# ==============================================================================

# SUT 节点 1 (Subject Under Test 1)
SUT1_IP=192.168.10.101
SUT1_PORT=8000
SUT1_HOST=sut1
SUT1_URL=http://192.168.10.101:8000

# SUT 节点 2 (Subject Under Test 2)
SUT2_IP=192.168.10.102
SUT2_PORT=8000
SUT2_HOST=sut2
SUT2_URL=http://192.168.10.102:8000

# 压测主控与影子容器配置
CONTROLLER_IP=192.168.10.100
BURST_CONCURRENCY=22
REQUEST_TIMEOUT_S=30

# 硬件参数
ROCE_DEV=mlx5_0
ROCE_GID_INDEX=3
NUMA_NODE=0
